# ============ EmonLens 生产环境变量（cp 为 .env 后修改） ============
# 必填：安全凭据。以下占位值会被生产启动门禁拒绝，部署前必须替换为随机值：
#   openssl rand -hex 32
EMONLENS_JWT_SECRET=change-me-to-a-random-string-at-least-16-chars
EMONLENS_INGEST_KEY=prod-trust-key-change-me
EMONLENS_ADMIN_PASSWORD=change-me-admin-password

# 必填：数据库口令
MYSQL_ROOT_PASSWORD=change-me-root-password
EMONLENS_DB_PASSWORD=change-me-db-password
EMONLENS_DB_USER=emonlens

# 可选：服务暴露
EMONLENS_PORT=8300
EMONLENS_BIND=127.0.0.1          # 需要外部访问时改为 0.0.0.0（建议前置 nginx）

# 可选：运行时
EMONLENS_RATE_LIMIT=600          # 控制面全局限流（次/分钟），0=不限
EMONLENS_INGEST_RATE_LIMIT=20000 # 每 workspace ingest 限流（spans/分钟），0=不限
EMONLENS_TRUST_XFF=false         # 部署在可信反代之后改为 true（登录限流按 XFF 取 IP）
EMONLENS_LOG_LEVEL=INFO
EMONLENS_LOG_FILE=/app/logs/emonlens.log  # 容器内日志文件路径
EMONLENS_WORKER_ENABLED=true     # true=本实例同时跑后台任务；独立 worker 进程部署时 api 实例改 false
EMONLENS_EVAL_CACHE_ENABLED=false # true=LLM Judge 结果缓存（严格 key + TTL）
EMONLENS_DATASET_SYNTHESIS_ENABLED=false # true=允许 LLM 合成候选（需配置 LLM 端点）
JAVA_OPTS=-Xms512m -Xmx1024m
