# =====================================================================
# 仅用于 compose 只读命令（ps / logs / down / top）在 .env 缺失时的插值兜底。
# 这里的值永远不会被用来启动容器：scripts/compose.sh 只对本文件放行只读子命令，
# 需要启停必须由 make up / docker compose up 读取真实的 .env。
# 请勿填写真实凭据到此文件。
# =====================================================================
MYSQL_ROOT_PASSWORD=placeholder-not-a-real-credential
EMONLENS_DB_PASSWORD=placeholder-not-a-real-credential
EMONLENS_JWT_SECRET=placeholder-not-a-real-credential
EMONLENS_INGEST_KEY=placeholder-not-a-real-credential
EMONLENS_ADMIN_PASSWORD=placeholder-not-a-real-credential
