# ============================================================================
# EmonLens 分发件环境变量
#
# 用法：
#   cp conf/emonlens.env.example conf/emonlens.env
#   编辑 conf/emonlens.env（所有 change-me 换成强随机值）
#   bin/emonlens.sh start
#
# 该文件由 bin/setenv.sh 在启动时 source，仅对本进程生效，不写入系统环境。
# ============================================================================

# ---------- 必填：安全凭据（prod 门禁会校验，占位值/示例值拒绝启动）----------
# JWT 签名密钥，至少 16 字符（建议 openssl rand -hex 32）
EMONLENS_JWT_SECRET=change-me-to-a-random-string-at-least-16-chars
# 数据面 Ingest Key（SDK 的 X-Trust-Key），不得为 dev-trust-key-001 或示例值
EMONLENS_INGEST_KEY=prod-trust-key-change-me
# admin 初始口令轮换目标（至少 8 位；库中仍是种子 123456 时用它一次性替换）
EMONLENS_ADMIN_PASSWORD=change-me-admin-password

# ---------- 必填：数据库 ----------
EMONLENS_DB_HOST=127.0.0.1
EMONLENS_DB_PORT=3306
EMONLENS_DB_NAME=emonlens
EMONLENS_DB_USER=emonlens
EMONLENS_DB_PASSWORD=change-me-db-password
# 连接池上限（并发高时上调）
EMONLENS_DB_POOL=20

# ---------- 可选：服务暴露 ----------
# 服务端口。默认监听 0.0.0.0（所有网卡）；仅允许本机访问时用防火墙限制，
# 或启动时追加 JVM 参数 -Dserver.address=127.0.0.1
EMONLENS_PORT=8300

# ---------- 可选：运行时 ----------
# 控制面全局限流（次/分钟），0=不限
EMONLENS_RATE_LIMIT=600
# 每 workspace ingest 限流（spans/分钟），0=不限
EMONLENS_INGEST_RATE_LIMIT=20000
# 部署在可信反代之后置 true（登录限流按 X-Forwarded-For 取真实 IP）
EMONLENS_TRUST_XFF=false
EMONLENS_LOG_LEVEL=INFO
# 日志文件路径；默认 $APP_HOME/logs/emonlens.log（留空即用默认）
#EMONLENS_LOG_FILE=
# true=本实例同时跑后台任务；独立 worker 进程部署时 api 实例改 false
EMONLENS_WORKER_ENABLED=true
# LLM Judge 结果缓存（严格 key + TTL）；默认 false
EMONLENS_EVAL_CACHE_ENABLED=false
# 数据集合成（LLM 生成候选 + 人工批准）；默认 false，开启前先配置系统设置 → LLM 端点
EMONLENS_DATASET_SYNTHESIS_ENABLED=false
# OTLP/HTTP-JSON 接入请求体字符上限（超出返回 400）；collector 大批次时可调大
EMONLENS_OTLP_MAX_BODY_CHARS=33554432
# JVM 参数（含空格的值建议加引号；不加引号也可，脚本按整行解析）
JAVA_OPTS="-Xms512m -Xmx1024m"

# ---------- 可选：Spring profile ----------
# 默认 prod（启用启动门禁）。仅本地演示才改为空：SPRING_PROFILES_ACTIVE=
SPRING_PROFILES_ACTIVE=prod
